<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>jaco_vla</name>
  <version>0.1.0</version>
  <description>Asynchronous VLA inference and native Gen2 Cartesian execution</description>
  <maintainer email="maintainers@example.invalid">Jaco VLA maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>jaco_vla_interfaces</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>image_tools</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- Python transport, controller and recording packages are installed in .venv. -->
  <exec_depend>python3-venv</exec_depend>
  <exec_depend>python3-pip</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>libusb-1.0</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
